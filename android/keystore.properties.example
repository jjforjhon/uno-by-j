# Keystore properties template for UNO by J
# Copy this file to 'keystore.properties' (ignored by git) and replace with your actual values:
#
# Generate a new release keystore via:
# keytool -genkey -v -keystore release.keystore -alias uno-key -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.keystore
storePassword=YourStorePasswordHere
keyAlias=uno-key
keyPassword=YourKeyPasswordHere
